---
import { buttonVariants } from "@/components/ui/button";
import { u } from "@/lib/base";

const path = Astro.url.pathname;
const nav = [
  { href: u("/"), label: "Overview", active: path === "/" || path === u("/") },
  { href: u("/#filters"), label: "Filters", active: false },
  { href: u("/about/"), label: "About & sources", active: path.startsWith(u("/about/")) },
];
---

<header class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur">
  <div class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-6">
    <a href={u("/")} class="group flex items-center gap-2.5">
      <span
        class="flex h-8 w-8 items-center justify-center rounded-lg bg-lav-100 font-mono text-base text-lav-700 ring-1 ring-lav-200 transition-colors group-hover:bg-lav-200"
        aria-hidden="true">⇄</span
      >
      <span class="block text-[17px] font-semibold leading-tight tracking-tight">Reversible Language Gallery</span>
    </a>
    <nav class="flex items-center gap-1">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class={buttonVariants({ variant: item.active ? "secondary" : "ghost", size: "sm" })}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
