---
import "@/styles/global.css";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "A field guide to reversible programming languages: what they are, how they work, who invented them, and where to find papers, sources, and implementations.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Reversible Language Gallery</title>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='0.9em' font-size='90'%3E%E2%87%84%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-paper font-sans text-ink antialiased">
    <SiteHeader />
    <main class="mx-auto w-full max-w-5xl flex-1 px-6 pb-24 pt-10">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
